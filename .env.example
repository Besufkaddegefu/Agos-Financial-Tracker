# Client (Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server (Vercel / serverless API)
CLERK_SECRET_KEY=sk_test_...
DATABASE_URL=
NEON_DATABASE_URL=

# Optional: Vite proxy target for the local API server
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Set true to use Neon-backed /api (run npm run dev:api locally or deploy the API; Clerk sign-in required)
VITE_USE_API=false
